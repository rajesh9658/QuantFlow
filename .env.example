# =====================================================================
# QuantFlow Local Environment Configuration
# Copy this template to .env before starting the stack:
#     cp .env.example .env
# .env is gitignored and MUST NEVER contain real production secrets.
# =====================================================================

# ---------- Application ----------
APP_ENV=development              # development | test | paper | live
APP_PORT=8000
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console (dev) | json (prod)

# ---------- PostgreSQL Credentials ----------
# POSTGRES_HOST and POSTGRES_PORT are overridden inside docker-compose
# for inter-container networking (postgres:5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quantflow
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=quantflow

# ---------- Redis & Cache Configuration ----------
# Inter-container networking defaults to redis:6379 in docker-compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                  # Leave blank for local development
REDIS_URL=redis://localhost:6379/0

# =====================================================================
# Exchange API Credentials (TESTNET / SANDBOX ONLY)
# =====================================================================
# CRITICAL NOTICE:
# Use ONLY testnet/sandbox API credentials here. Never commit, paste, or
# run real production exchange keys with live capital in local development!
#
# Binance Spot & Futures Testnet (https://testnet.binance.vision/)
BINANCE_API_KEY=your_binance_testnet_api_key
BINANCE_API_SECRET=your_binance_testnet_api_secret

# Bybit Testnet (https://testnet.bybit.com/)
BYBIT_API_KEY=your_bybit_testnet_api_key
BYBIT_API_SECRET=your_bybit_testnet_api_secret

# ---------- Go-Live Safety Attestation ----------
# Required for production guardrails (e.g., openssl rand -hex 32)
QUANTFLOW_GO_LIVE_SIGNING_KEY=change_me_to_64_hex_characters_minimum_security_key

# ---------- Optional Feature Overrides ----------
# EventBus backend: in_memory | redis
QUANTFLOW_EVENT_BUS_TYPE=in_memory
